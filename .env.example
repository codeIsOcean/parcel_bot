# === Telegram Bot ===
BOT_TOKEN=your_bot_token_here
BOT_WEBHOOK_URL=https://fly.kazakhindubai.com/webhook

# Режим апдейтов: true — webhook (рабочий), false — polling (запасной).
# На одном токене может работать только один процесс.
USE_WEBHOOK=false
WEBHOOK_PATH=/webhook
WEBHOOK_PORT=8081
WEBHOOK_SECRET=generate_a_long_random_string

# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/parcel_bot
# Для dev-режима можно SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./parcel_bot.db

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === FastAPI Backend ===
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=your_secret_key_for_jwt
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === WebApp ===
VITE_API_URL=/api/v1
WEBAPP_URL=https://fly.kazakhindubai.com

# Юзернейм бота без @ — из него строятся ссылки в объявлениях по чатам
BOT_USERNAME=parcel07test_bot

# Кто может подключать чаты к рассылке рейсов и отвечать в поддержке из бота
# (Telegram ID через запятую)
ADMIN_IDS=

# === CRM — мост чата поддержки в KVD Ads Panel (cabinet.kazakhindubai.com) ===
# Копии сообщений поддержки уходят в панель (вкладка «Посылки»), ответы из
# панели приходят на /api/v1/internal/crm/reply. Оба пустые → мост выключен.
# Секрет тот же, что CRM_PARCEL_API_KEY в .env.prod панели.
# CRM_INGEST_URL=https://cabinet.kazakhindubai.com/api/v1/crm/ingest
CRM_INGEST_URL=
CRM_API_KEY=

# === Docker Production ===
POSTGRES_PASSWORD=your_strong_password_here
GITHUB_REPO=your_username/parcel_bot

# === TON Payments ===
# Пустой адрес выключает оплату в TON и фоновый опрос блокчейна
TON_WALLET_ADDRESS=
TON_API_KEY=
TON_API_URL=https://toncenter.com/api/v2
TON_PAYMENT_TIMEOUT_SECONDS=1800
TON_POLL_INTERVAL_SECONDS=60

# === Медиа ===
# Каталог загруженных фотографий. В контейнере смонтирован том.
MEDIA_ROOT=/app/media

# === Монетизация ===
# Платит только перевозчик. Отправитель публикует посылки и переписывается
# бесплатно. Перевозчик видит все заявки, но чтобы ответить, у него должен
# быть открыт сегодняшний рабочий день.

# Дневной тариф в звёздах. Списывается один раз в сутки, в день первого ответа.
DAILY_FEE_STARS=30

# Сколько активных дней даётся новому перевозчику бесплатно.
# Активный день — день, когда он реально отвечал на заявки.
TRIAL_ACTIVE_DAYS=14

# Пакеты пополнения баланса. Произвольные суммы запрещены.
TOPUP_PACKAGES_STARS=50,100,250,500,1000

# Ориентировочная стоимость одной звезды в долларах (для пересчёта в TON)
STAR_USD_RATE=0.02

# Общий период запуска: до этой даты отвечают все бесплатно и личные
# пробные дни не тратятся (YYYY-MM-DD). Пусто — период выключен.
FREE_ACCESS_UNTIL=

# Сколько закрытых доставок даёт перевозчику галочку верификации
VERIFIED_DELIVERIES_THRESHOLD=5

# === Subscription Prices (USD) — второй тариф для тех, кто летает часто ===
SUBSCRIPTION_MONTHLY_PRICE=40
SUBSCRIPTION_QUARTERLY_PRICE=100
SUBSCRIPTION_YEARLY_PRICE=300

# === Logging ===
LOG_LEVEL=INFO
